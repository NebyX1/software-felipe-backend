# Mismo formato de conexión que buzon-ciudadano-backend.
FLASK_APP=app
FLASK_CONFIG=production
DATABASE_URL=mariadb+mariadbconnector://root:password@localhost:3306/software_felipe
SECRET_KEY=
JWT_SECRET_KEY=
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
FRONTEND_URL=https://obras.example.com
CORS_ORIGINS=https://obras.example.com
COOKIE_SECURE=true
TRUST_PROXY=true
REDIS_URL=memory://
DOCUMENT_STORAGE=minio
MINIO_ENDPOINT=minio.example.com
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=software-felipe
MINIO_SECURE=true
BOOTSTRAP_ON_START=true
INIT_BUCKET_ON_START=true
# Cuentas sintéticas y datos iniciales de esta demo de obras.
DEMO_AUTH_ENABLED=true
DEMO_ENVIRONMENT=true
DEMO_ACCESS_REQUIRED=true
DEMO_ACCESS_CODE=
DEMO_SEED_ON_START=true
AI_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
