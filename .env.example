# Coolify (Docker Compose): sólo FRONTEND_URL es obligatorio.
FRONTEND_URL=https://obras.example.com
# Coolify genera SERVICE_PASSWORD_* y SERVICE_USER_MINIO automáticamente.
# Se pueden sobrescribir con secretos propios; nunca usar valores de ejemplo.
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
# SECRET_KEY=
# JWT_SECRET_KEY=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# DEMO_ACCESS_CODE=
# La IA es opcional. Estas variables son exclusivamente del backend.
AI_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
